<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= selected ? selected.name + ' · ' : '' %>Exercises · Repwise</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,900&family=DM+Sans:wght@300;400;500;700&display=swap">
  <link rel="stylesheet" href="/css/app.css">
</head>
<%
  const label = (s) => s[0].toUpperCase() + s.slice(1);
  const field = (v) => (v ? label(v) : 'Not set');
%>
<body class="admin<%= selected || notFound ? ' has-detail' : '' %>">
  <%- include('partials/topbar', { tab: 'exercises' }) %>
  <main class="workspace">
    <div class="workspace-head">
      <h1 class="page-title">Exercises</h1>
      <form class="search" method="get" action="/admin/exercises" role="search">
        <label class="visually-hidden" for="q">Search by name</label>
        <input id="q" name="q" type="search" value="<%= q %>" placeholder="Search by name" autocomplete="off">
        <% if (q) { %><a class="search-clear" href="/admin/exercises">Clear</a><% } %>
      </form>
    </div>

    <div class="split">
      <section class="list-panel" aria-label="Exercise list">
        <% if (error) { %>
          <p class="list-message"><%= error %></p>
        <% } else if (!rows.length) { %>
          <p class="list-message">
            <% if (q) { %>No exercises match "<%= q %>". Clear the filters, or add it as a new exercise.<% } else { %>No exercises yet. Run the seed to import the library.<% } %>
          </p>
        <% } else { %>
          <% if (q) { %><p class="list-count"><%= rows.length %><%= hasMore ? '+' : '' %> matching "<%= q %>"</p><% } %>
          <ul class="rows">
            <% rows.forEach((row, i) => { %>
              <li id="row-<%= i %>">
                <a class="row" href="/admin/exercises/<%= encodeURIComponent(row.id) %><%= keep %>#row-<%= i %>"<% if (selected && selected.id === row.id) { %> aria-current="true"<% } %>>
                  <span class="thumb">
                    <% row.thumbs.forEach((src, f) => { %><img class="frame-<%= f %>" src="<%= src %>" alt="" width="48" height="48" loading="lazy"><% }) %>
                    <% if (row.hasGif) { %><span class="gif-mark">GIF</span><% } %>
                  </span>
                  <span class="row-text">
                    <span class="row-name"><%= row.name %></span>
                    <span class="row-group"><%= row.group %></span>
                  </span>
                  <span class="status status-<%= row.status %>"><%= label(row.status) %></span>
                </a>
              </li>
            <% }) %>
          </ul>
          <% if (hasMore) { %>
            <a class="load-more" href="<%= base %><%= more %>">Load more</a>
          <% } %>
        <% } %>
      </section>

      <section class="detail-panel" aria-label="Exercise details">
        <% if (selected) { %>
          <a class="back" href="/admin/exercises<%= keep %>">Back to list</a>
          <header class="detail-head">
            <h2 class="detail-name"><%= selected.name %></h2>
            <span class="status status-<%= selected.status %>"><%= label(selected.status) %></span>
          </header>

          <% if (selected.gif) { %>
            <div class="media media-gif">
              <figure class="media-tile"><img src="<%= selected.gif %>" alt="<%= selected.name %>, animated"></figure>
            </div>
          <% } else if (selected.stills.length) { %>
            <div class="media">
              <figure class="media-tile preview" aria-hidden="true">
                <% selected.stills.forEach((src, f) => { %><img class="frame-<%= f %>" src="<%= src %>" alt=""><% }) %>
                <figcaption>App preview</figcaption>
              </figure>
              <% selected.stills.forEach((src, f) => { %>
                <figure class="media-tile still"><img src="<%= src %>" alt="<%= selected.name %>, frame <%= f + 1 %>"></figure>
              <% }) %>
            </div>
          <% } else { %>
            <div class="media media-empty"><p>No images yet.</p></div>
          <% } %>

          <dl class="tiles">
            <div class="tile"><dt>Muscle group</dt><dd><%= selected.group %></dd></div>
            <div class="tile"><dt>Target</dt><dd><%= selected.target %></dd></div>
            <div class="tile"><dt>Equipment</dt><dd><%= selected.equipment %></dd></div>
          </dl>

          <% if (selected.secondaries.length) { %>
            <h3 class="detail-label">Also works</h3>
            <ul class="chips">
              <% selected.secondaries.forEach((m) => { %><li class="chip"><%= m %></li><% }) %>
            </ul>
          <% } %>

          <dl class="facts">
            <div><dt>Level</dt><dd><%= field(selected.level) %></dd></div>
            <div><dt>Category</dt><dd><%= field(selected.category) %></dd></div>
            <div><dt>Force</dt><dd><%= field(selected.force) %></dd></div>
            <div><dt>Mechanic</dt><dd><%= field(selected.mechanic) %></dd></div>
          </dl>

          <h3 class="detail-label">Guide</h3>
          <% if (selected.steps.length) { %>
            <ol class="steps">
              <% selected.steps.forEach((step) => { %><li><%= step %></li><% }) %>
            </ol>
          <% } else { %>
            <p class="detail-empty">No steps yet.</p>
          <% } %>
        <% } else if (notFound) { %>
          <a class="back" href="/admin/exercises<%= keep %>">Back to list</a>
          <p class="detail-empty">No exercise with that ID. Pick one from the list.</p>
        <% } else { %>
          <p class="detail-empty">Select an exercise to see its stills, muscles and steps as the app will show them.</p>
        <% } %>
      </section>
    </div>
  </main>
</body>
</html>
