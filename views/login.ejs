<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in · Repwise admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75,800&family=DM+Sans:wght@400;500;700&display=swap">
  <link rel="stylesheet" href="/css/app.css">
  <script type="module" src="/js/login.js"></script>
</head>
<body>
  <main class="login">
    <h1 class="wordmark">Repwise admin</h1>
    <p class="lede">Sign in to manage the Repwise exercise library.</p>

    <button type="button" id="google" class="button button-primary">Sign in with Google</button>

    <p class="divider">or use your email</p>

    <form id="email-form" class="form">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <button type="submit" class="button">Sign in</button>
    </form>

    <p id="message" class="message" role="alert" hidden></p>
  </main>
</body>
</html>
